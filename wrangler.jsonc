{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hailuoblog",
  "main": "edge/worker.js",
  "compatibility_date": "2026-09-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
